+def farcrysis_guard_red_test():
+    """Prove the admission guard can fire before trusting its pass.
+
+    The old farcrysis guard shipped vacuous once, so its successor keeps a red
+    test - and fires it on the axis that actually matters now: a build that DOES
+    offer farcrysis, with a receipt that fails. Both halves are proved: a
+    selectable build with a bad receipt must refuse, and the parked build must
+    still pass without any receipt at all.
+    """
+    import tempfile
+    global FARCRYSIS_ADMISSION_RECEIPT
+    saved = FARCRYSIS_ADMISSION_RECEIPT
+    with tempfile.TemporaryDirectory() as red_dir:
+        os.makedirs(os.path.join(red_dir, "assets"))
+        selectable = os.path.join(red_dir, "assets", "red-selectable.js")
+        with open(selectable, "wb") as fh:
+            fh.write(b"id:`farcrysis`,routeId:`farcrysis`,legacyAliases:[]")
+        bad = os.path.join(red_dir, "bad-receipt.json")
+        with open(bad, "w", encoding="utf-8") as fh:
+            json.dump({"contract": "farcrysis-admission-evidence-v1",
+                       "sha": sh(["git", "rev-parse", "HEAD"]).strip(),
+                       "runs": 3,
+                       "summary": {"allAdmitted": True, "anyCrashed": False,
+                                   "anyPageErrors": False, "maxMenuPipelines": 0,
+                                   "worstPairRatio": 99.0}}, fh)
+        try:
+            FARCRYSIS_ADMISSION_RECEIPT = bad
+            fired = False
+            try:
+                assert_farcrysis_admission_evidence(red_dir)
+            except SystemExit:
+                fired = True
+            if not fired:
+                sys.exit("REFUSING: the farcrysis admission guard failed its own red test "
+                         "- it cannot fire on a bad receipt")
+            # ...and a missing receipt on a selectable build must also refuse.
+            FARCRYSIS_ADMISSION_RECEIPT = os.path.join(red_dir, "absent.json")
+            fired = False
+            try:
+                assert_farcrysis_admission_evidence(red_dir)
+            except SystemExit:
+                fired = True
+            if not fired:
+                sys.exit("REFUSING: the farcrysis admission guard accepted a selectable "
+                         "build with no receipt at all")
+        finally:
+            FARCRYSIS_ADMISSION_RECEIPT = saved
+        # The parked case must still pass with no receipt present.
+        parked = os.path.join(red_dir, "parked")
+        os.makedirs(os.path.join(parked, "assets"))
+        with open(os.path.join(parked, "assets", "green.js"), "wb") as fh:
+            fh.write(b"id:`farcrysis`,routeId:`farcrysis`,selectable:!1,legacyAliases:[]")
+        assert_farcrysis_admission_evidence(parked)

